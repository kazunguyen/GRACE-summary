  33 /* allocate a Jbig2Image structure and its associated bitmap */
  34 Jbig2Image *
  35 jbig2_image_new(Jbig2Ctx *ctx, uint32_t width, uint32_t height)
  36 {
  37     Jbig2Image *image;
  38     uint32_t stride;
  39     int64_t check;
  40 
  41     image = jbig2_new(ctx, Jbig2Image, 1);
  42     if (image == NULL) {
  43         jbig2_error(ctx, JBIG2_SEVERITY_FATAL, -1, ""could not allocate image structure in jbig2_image_new"");
  44         return NULL;
  45     }
  46 
  47     stride = ((width - 1) >> 3) + 1;    /* generate a byte-aligned stride */
  48     /* check for integer multiplication overflow */
  49     check = ((int64_t) stride) * ((int64_t) height);
  50     if (check != (int)check) {
  51         jbig2_error(ctx, JBIG2_SEVERITY_FATAL, -1, ""integer multiplication overflow from stride(%d)*height(%d)"", stride, height);
  52         jbig2_free(ctx->allocator, image);
  53         return NULL;
  54     }
  55     /* Add 1 to accept runs that exceed image width and clamped to width+1 */
  56     image->data = jbig2_new(ctx, uint8_t, (int)check + 1);
  57     if (image->data == NULL) {
  58         jbig2_error(ctx, JBIG2_SEVERITY_FATAL, -1, ""could not allocate image data buffer! [stride(%d)*height(%d) bytes]"", stride, height);
  59         jbig2_free(ctx->allocator, image);
  60         return NULL;
  61     }
  62 
  63     image->width = width;
  64     image->height = height;
  65     image->stride = stride;
  66     image->refcount = 1;
  67 
  68     return image;
  69 }
  70 
  71 /* clone an image pointer by bumping its reference count */
  72 Jbig2Image *
  73 jbig2_image_clone(Jbig2Ctx *ctx, Jbig2Image *image)
  74 {
  75     if (image)
  76         image->refcount++;
  77     return image;
  78 }
  79 
  80 /* release an image pointer, freeing it it appropriate */
  81 void
  82 jbig2_image_release(Jbig2Ctx *ctx, Jbig2Image *image)
  83 {
  84     if (image == NULL)
  85         return;
  86     image->refcount--;
  87     if (!image->refcount)
  88         jbig2_image_free(ctx, image);
  89 }
  90 
  91 /* free a Jbig2Image structure and its associated memory */
  92 void
  93 jbig2_image_free(Jbig2Ctx *ctx, Jbig2Image *image)
  94 {
  95     if (image)
  96         jbig2_free(ctx->allocator, image->data);
  97     jbig2_free(ctx->allocator, image);
  98 }
