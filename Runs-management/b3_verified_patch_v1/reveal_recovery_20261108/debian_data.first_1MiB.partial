  38 /**
  39  * jbig2_decode_text_region: decode a text region segment
  40  *
  41  * @ctx: jbig2 decoder context
  42  * @segment: jbig2 segment (header) structure
  43  * @params: parameters from the text region header
  44  * @dicts: an array of referenced symbol dictionaries
  45  * @n_dicts: the number of referenced symbol dictionaries
  46  * @image: image structure in which to store the decoded region bitmap
  47  * @data: pointer to text region data to be decoded
  48  * @size: length of text region data
  49  *
  50  * Implements the text region decoding procedure
  51  * described in section 6.4 of the JBIG2 spec.
  52  *
  53  * returns: 0 on success
  54  **/
  55 int
  56 jbig2_decode_text_region(Jbig2Ctx *ctx, Jbig2Segment *segment,
  57                          const Jbig2TextRegionParams *params,
  58                          const Jbig2SymbolDict *const *dicts, const uint32_t n_dicts,
  59                          Jbig2Image *image, const byte *data, const size_t size, Jbig2ArithCx *GR_stats, Jbig2ArithState *as, Jbig2WordStream *ws)
  60 {
  61     /* relevent bits of 6.4.4 */
  62     uint32_t NINSTANCES;
  63     uint32_t ID;
  64     int32_t STRIPT;
  65     int32_t FIRSTS;
  66     int32_t DT;
  67     int32_t DFS;
  68     int32_t IDS;
  69     int32_t CURS;
  70     int32_t CURT;
  71     int S, T;
  72     int x, y;
  73     bool first_symbol;
  74     uint32_t index, SBNUMSYMS;
  75     Jbig2Image *IB = NULL;
  76     Jbig2HuffmanState *hs = NULL;
  77     Jbig2HuffmanTable *SBSYMCODES = NULL;
  78     int code = 0;
  79     int RI;
  80 
  81     SBNUMSYMS = 0;
  82     for (index = 0; index < n_dicts; index++) {
  83         SBNUMSYMS += dicts[index]->n_symbols;
  84     }
  85     jbig2_error(ctx, JBIG2_SEVERITY_DEBUG, segment->number, ""symbol list contains %d glyphs in %d dictionaries"", SBNUMSYMS, n_dicts);
  86 
  87     if (params->SBHUFF) {
  88         Jbig2HuffmanTable *runcodes = NULL;
  89         Jbig2HuffmanParams runcodeparams;
  90         Jbig2HuffmanLine runcodelengths[35];
  91         Jbig2HuffmanLine *symcodelengths = NULL;
  92         Jbig2HuffmanParams symcodeparams;
  93         int err, len, range, r;
  94 
  95         jbig2_error(ctx, JBIG2_SEVERITY_DEBUG, segment->number, ""huffman coded text region"");
  96         hs = jbig2_huffman_new(ctx, ws);
  97         if (hs == NULL) {
  98             jbig2_error(ctx, JBIG2_SEVERITY_WARNING, segment->number, ""failed to allocate storage for text region"");
  99             return -1;
 100         }
 101 
 102         /* 7.4.3.1.7 - decode symbol ID Huffman table */
 103         /* this is actually part of the segment header, but it is more
 104            convenient to handle it here */
 105 
 106         /* parse and build the runlength code huffman table */
 107         for (index = 0; index < 35; index++) {
 108             runcodelengths[index].PREFLEN = jbig2_huffman_get_bits(hs, 4, &code);
 109             if (code < 0)
 110                 goto cleanup1;
 111             runcodelengths[index].RANGELEN = 0;
 112             runcodelengths[index].RANGELOW = index;
 113             jbig2_error(ctx, JBIG2_SEVERITY_DEBUG, segment->number, ""  read runcode%d length %d"", index, runcodelengths[index].PREFLEN);
 114         }
 115         runcodeparams.HTOOB = 0;
 116         runcodeparams.lines = runcodelengths;
 117         runcodeparams.n_lines = 35;
 118         runcodes = jbig2_build_huffman_table(ctx, &runcodeparams);
 119         if (runcodes == NULL) {
 120             jbig2_error(ctx, JBIG2_SEVERITY_FATAL, segment->number, ""error constructing symbol id runcode table!"");
 121             code = -1;
 122             goto cleanup1;
 123         }
 124 
 125         /* decode the symbol id codelengths using the runlength table */
 126         symcodelengths = jbig2_new(ctx, Jbig2HuffmanLine, SBNUMSYMS);
 127         if (symcodelengths == NULL) {
 128             jbig2_error(ctx, JBIG2_SEVERITY_FATAL, segment->number, ""memory allocation failure reading symbol ID huffman table!"");
 129             code = -1;
 130             goto cleanup1;
 131         }
 132         index = 0;
 133         while (index < SBNUMSYMS) {
 134             code = jbig2_huffman_get(hs, runcodes, &err);
 135             if (err != 0 || code < 0 || code >= 35) {
 136                 jbig2_error(ctx, JBIG2_SEVERITY_FATAL, segment->number, ""error reading symbol ID huffman table!"");
 137                 code = err ? err : -1;
 138                 goto cleanup1;
 139             }
 140 
 141             if (code < 32) {
 142                 len = code;
 143                 range = 1;
 144             } else {
 145                 if (code == 32) {
 146                     if (index < 1) {
 147                         jbig2_error(ctx, JBIG2_SEVERITY_FATAL, segment->number, ""error decoding symbol id table: run length with no antecedent!"");
 148                         code = -1;
 149                         goto cleanup1;
 150                     }
 151                     len = symcodelengths[index - 1].PREFLEN;
 152                 } else {
 153                     len = 0;    /* code == 33 or 34 */
 154                 }
 155                 err = 0;
 156                 if (code == 32)
 157                     range = jbig2_huffman_get_bits(hs, 2, &err) + 3;
 158                 else if (code == 33)
 159                     range = jbig2_huffman_get_bits(hs, 3, &err) + 3;
 160                 else if (code == 34)
 161                     range = jbig2_huffman_get_bits(hs, 7, &err) + 11;
 162                 if (err < 0)
 163                     goto cleanup1;
 164             }
 165             jbig2_error(ctx, JBIG2_SEVERITY_DEBUG, segment->number, ""  read runcode%d at index %d (length %d range %d)"", code, index, len, range);
 166             if (index + range > SBNUMSYMS) {
 167                 jbig2_error(ctx, JBIG2_SEVERITY_WARNING, segment->number,
 168                             ""runlength extends %d entries beyond the end of symbol id table!"", index + range - SBNUMSYMS);
 169                 range = SBNUMSYMS - index;
 170             }
 171             for (r = 0; r < range; r++) {
 172                 symcodelengths[index + r].PREFLEN = len;
 173                 symcodelengths[index + r].RANGELEN = 0;
 174                 symcodelengths[index + r].RANGELOW = index + r;
 175             }
 176             index += r;
 177         }
 178 
 179         if (index < SBNUMSYMS) {
 180             jbig2_error(ctx, JBIG2_SEVERITY_WARNING, segment->number, ""runlength codes do not cover the available symbol set"");
 181         }
 182         symcodeparams.HTOOB = 0;
 183         symcodeparams.lines = symcodelengths;
 184         symcodeparams.n_lines = SBNUMSYMS;
 185 
 186         /* skip to byte boundary */
 187         jbig2_huffman_skip(hs);
 188 
 189         /* finally, construct the symbol id huffman table itself */
 190         SBSYMCODES = jbig2_build_huffman_table(ctx, &symcodeparams);
 191 
 192 cleanup1:
 193         jbig2_free(ctx->allocator, symcodelengths);
 194         jbig2_release_huffman_table(ctx, runcodes);
 195 
 196         if (SBSYMCODES == NULL) {
 197             jbig2_error(ctx, JBIG2_SEVERITY_FATAL, segment->number, ""could not construct Symbol ID huffman table!"");
 198             jbig2_huffman_free(ctx, hs);
 199             return ((code != 0) ? code : -1);
 200         }
 201     }
 202 
 203     /* 6.4.5 (1) */
 204     jbig2_image_clear(ctx, image, params->SBDEFPIXEL);
 205 
 206     /* 6.4.6 */
 207     if (params->SBHUFF) {
 208         STRIPT = jbig2_huffman_get(hs, params->SBHUFFDT, &code);
 209     } else {
 210         code = jbig2_arith_int_decode(params->IADT, as, &STRIPT);
 211     }
 212     if (code < 0)
 213         goto cleanup2;
 214 
 215     /* 6.4.5 (2) */
 216     STRIPT *= -(params->SBSTRIPS);
 217     FIRSTS = 0;
 218     NINSTANCES = 0;
 219 
 220     /* 6.4.5 (3) */
 221     while (NINSTANCES < params->SBNUMINSTANCES) {
 222         /* (3b) */
 223         if (params->SBHUFF) {
 224             DT = jbig2_huffman_get(hs, params->SBHUFFDT, &code);
 225         } else {
 226             code = jbig2_arith_int_decode(params->IADT, as, &DT);
 227         }
 228         if (code < 0)
 229             goto cleanup2;
 230         DT *= params->SBSTRIPS;
 231         STRIPT += DT;
 232 
 233         first_symbol = TRUE;
 234         /* 6.4.5 (3c) - decode symbols in strip */
 235         for (;;) {
 236             /* (3c.i) */
 237             if (first_symbol) {
 238                 /* 6.4.7 */
 239                 if (params->SBHUFF) {
 240                     DFS = jbig2_huffman_get(hs, params->SBHUFFFS, &code);
 241                 } else {
 242                     code = jbig2_arith_int_decode(params->IAFS, as, &DFS);
 243                 }
 244                 if (code < 0)
 245                     goto cleanup2;
 246                 FIRSTS += DFS;
 247                 CURS = FIRSTS;
 248                 first_symbol = FALSE;
 249             } else {
 250                 if (NINSTANCES > params->SBNUMINSTANCES) {
 251                     code = jbig2_error(ctx, JBIG2_SEVERITY_FATAL, segment->number, ""too many NINSTANCES (%d) decoded"", NINSTANCES);
 252                     break;
 253                 }
 254                 /* (3c.ii) / 6.4.8 */
 255                 if (params->SBHUFF) {
 256                     IDS = jbig2_huffman_get(hs, params->SBHUFFDS, &code);
 257                 } else {
 258                     code = jbig2_arith_int_decode(params->IADS, as, &IDS);
 259                 }
 260                 if (code) {
 261                     /* decoded an OOB, reached end of strip */
 262                     break;
 263                 }
 264                 CURS += IDS + params->SBDSOFFSET;
 265             }
 266 
 267             /* (3c.iii) / 6.4.9 */
 268             if (params->SBSTRIPS == 1) {
 269                 CURT = 0;
 270             } else if (params->SBHUFF) {
 271                 CURT = jbig2_huffman_get_bits(hs, params->LOGSBSTRIPS, &code);
 272             } else {
 273                 code = jbig2_arith_int_decode(params->IAIT, as, &CURT);
 274             }
 275             if (code < 0)
 276                 goto cleanup2;
 277             T = STRIPT + CURT;
 278 
 279             /* (3b.iv) / 6.4.10 - decode the symbol id */
 280             if (params->SBHUFF) {
 281                 ID = jbig2_huffman_get(hs, SBSYMCODES, &code);
 282             } else {
 283                 code = jbig2_arith_iaid_decode(params->IAID, as, (int *)&ID);
 284             }
 285             if (code < 0)
 286                 goto cleanup2;
 287             if (ID >= SBNUMSYMS) {
 288                 code = jbig2_error(ctx, JBIG2_SEVERITY_FATAL, segment->number, ""symbol id out of range! (%d/%d)"", ID, SBNUMSYMS);
 289                 goto cleanup2;
 290             }
 291 
 292             /* (3c.v) / 6.4.11 - look up the symbol bitmap IB */
 293             {
 294                 uint32_t id = ID;
 295 
 296                 index = 0;
 297                 while (id >= dicts[index]->n_symbols)
 298                     id -= dicts[index++]->n_symbols;
 299                 IB = jbig2_image_clone(ctx, dicts[index]->glyphs[id]);
 300                 /* SumatraPDF: fail on missing glyphs */
 301                 if (!IB) {
 302                     code = jbig2_error(ctx, JBIG2_SEVERITY_FATAL, segment->number, ""missing glyph %d/%d!"", index, id);
 303                     goto cleanup2;
 304                 }
 305             }
 306             if (params->SBREFINE) {
 307                 if (params->SBHUFF) {
 308                     RI = jbig2_huffman_get_bits(hs, 1, &code);
 309                 } else {
 310                     code = jbig2_arith_int_decode(params->IARI, as, &RI);
 311                 }
 312                 if (code < 0)
 313                     goto cleanup2;
 314             } else {
 315                 RI = 0;
 316             }
 317             if (RI) {
 318                 Jbig2RefinementRegionParams rparams;
 319                 Jbig2Image *IBO;
 320                 int32_t RDW, RDH, RDX, RDY;
 321                 Jbig2Image *refimage;
 322                 int BMSIZE = 0;
 323                 int code1 = 0;
 324                 int code2 = 0;
 325                 int code3 = 0;
 326                 int code4 = 0;
 327                 int code5 = 0;
 328 
 329                 /* 6.4.11 (1, 2, 3, 4) */
 330                 if (!params->SBHUFF) {
 331                     code1 = jbig2_arith_int_decode(params->IARDW, as, &RDW);
 332                     code2 = jbig2_arith_int_decode(params->IARDH, as, &RDH);
 333                     code3 = jbig2_arith_int_decode(params->IARDX, as, &RDX);
 334                     code4 = jbig2_arith_int_decode(params->IARDY, as, &RDY);
 335                 } else {
 336                     RDW = jbig2_huffman_get(hs, params->SBHUFFRDW, &code1);
 337                     RDH = jbig2_huffman_get(hs, params->SBHUFFRDH, &code2);
 338                     RDX = jbig2_huffman_get(hs, params->SBHUFFRDX, &code3);
 339                     RDY = jbig2_huffman_get(hs, params->SBHUFFRDY, &code4);
 340                     BMSIZE = jbig2_huffman_get(hs, params->SBHUFFRSIZE, &code5);
 341                     jbig2_huffman_skip(hs);
 342                 }
 343 
 344                 if ((code1 < 0) || (code2 < 0) || (code3 < 0) || (code4 < 0) || (code5 < 0)) {
 345                     code = jbig2_error(ctx, JBIG2_SEVERITY_FATAL, segment->number, ""failed to decode data"");
 346                     goto cleanup2;
 347                 }
 348 
 349                 /* 6.4.11 (6) */
 350                 IBO = IB;
 351                 refimage = jbig2_image_new(ctx, IBO->width + RDW, IBO->height + RDH);
 352                 if (refimage == NULL) {
 353                     jbig2_image_release(ctx, IBO);
 354                     if (params->SBHUFF) {
 355                         jbig2_release_huffman_table(ctx, SBSYMCODES);
 356                     }
 357                     return jbig2_error(ctx, JBIG2_SEVERITY_FATAL, segment->number, ""couldn't allocate reference image"");
 358                 }
 359                 jbig2_image_clear(ctx, refimage, 0x00);
 360 
 361                 /* Table 12 */
 362                 rparams.GRTEMPLATE = params->SBRTEMPLATE;
 363                 rparams.reference = IBO;
 364                 rparams.DX = (RDW >> 1) + RDX;
 365                 rparams.DY = (RDH >> 1) + RDY;
 366                 rparams.TPGRON = 0;
 367                 memcpy(rparams.grat, params->sbrat, 4);
 368                 code = jbig2_decode_refinement_region(ctx, segment, &rparams, as, refimage, GR_stats);
 369                 if (code < 0) {
 370                     jbig2_image_release(ctx, refimage);
 371                     goto cleanup2;
 372                 }
 373                 IB = refimage;
 374 
 375                 jbig2_image_release(ctx, IBO);
 376 
 377                 /* 6.4.11 (7) */
 378                 if (params->SBHUFF) {
 379                     jbig2_huffman_advance(hs, BMSIZE);
 380                 }
 381 
 382             }
 383 
 384             /* (3c.vi) */
 385             if ((!params->TRANSPOSED) && (params->REFCORNER > 1)) {
 386                 CURS += IB->width - 1;
 387             } else if ((params->TRANSPOSED) && !(params->REFCORNER & 1)) {
 388                 CURS += IB->height - 1;
 389             }
 390 
 391             /* (3c.vii) */
 392             S = CURS;
 393 
 394             /* (3c.viii) */
 395             if (!params->TRANSPOSED) {
 396                 switch (params->REFCORNER) {
 397                 case JBIG2_CORNER_TOPLEFT:
 398                     x = S;
 399                     y = T;
 400                     break;
 401                 case JBIG2_CORNER_TOPRIGHT:
 402                     x = S - IB->width + 1;
 403                     y = T;
 404                     break;
 405                 case JBIG2_CORNER_BOTTOMLEFT:
 406                     x = S;
 407                     y = T - IB->height + 1;
 408                     break;
 409                 default:
 410                 case JBIG2_CORNER_BOTTOMRIGHT:
 411                     x = S - IB->width + 1;
 412                     y = T - IB->height + 1;
 413                     break;
 414                 }
 415             } else {            /* TRANSPOSED */
 416                 switch (params->REFCORNER) {
 417                 case JBIG2_CORNER_TOPLEFT:
 418                     x = T;
 419                     y = S;
 420                     break;
 421                 case JBIG2_CORNER_TOPRIGHT:
 422                     x = T - IB->width + 1;
 423                     y = S;
 424                     break;
 425                 case JBIG2_CORNER_BOTTOMLEFT:
 426                     x = T;
 427                     y = S - IB->height + 1;
 428                     break;
 429                 default:
 430                 case JBIG2_CORNER_BOTTOMRIGHT:
 431                     x = T - IB->width + 1;
 432                     y = S - IB->height + 1;
 433                     break;
 434                 }
 435             }
 436 
 437             /* (3c.ix) */
 438 #ifdef JBIG2_DEBUG
 439             jbig2_error(ctx, JBIG2_SEVERITY_DEBUG, segment->number,
 440                         ""composing glyph id %d: %dx%d @ (%d,%d) symbol %d/%d"", ID, IB->width, IB->height, x, y, NINSTANCES + 1, params->SBNUMINSTANCES);
 441 #endif
 442             code = jbig2_image_compose(ctx, image, IB, x, y, params->SBCOMBOP);
 443             if (code < 0) {
 444                 jbig2_image_release(ctx, IB);
 445                 goto cleanup2;
 446             }
 447 
 448             /* (3c.x) */
 449             if ((!params->TRANSPOSED) && (params->REFCORNER < 2)) {
 450                 CURS += IB->width - 1;
 451             } else if ((params->TRANSPOSED) && (params->REFCORNER & 1)) {
 452                 CURS += IB->height - 1;
 453             }
 454 
 455             /* (3c.xi) */
 456             NINSTANCES++;
 457 
 458             jbig2_image_release(ctx, IB);
 459         }
 460         /* end strip */
 461     }
 462     /* 6.4.5 (4) */
 463 
 464 cleanup2:
 465     if (params->SBHUFF) {
 466         jbig2_release_huffman_table(ctx, SBSYMCODES);
 467     }
 468     jbig2_huffman_free(ctx, hs);
 469 
 470     return code;
 471 }
 472 
 473 /**
 474  * jbig2_text_region: read a text region segment header
 475  **/
 476 int
 477 jbig2_text_region(Jbig2Ctx *ctx, Jbig2Segment *segment, const byte *segment_data)
 478 {
 479     uint32_t offset = 0;
 480     Jbig2RegionSegmentInfo region_info;
 481     Jbig2TextRegionParams params;
 482     Jbig2Image *image = NULL;
 483     Jbig2SymbolDict **dicts = NULL;
 484     uint32_t n_dicts = 0;
 485     uint16_t flags = 0;
 486     uint16_t huffman_flags = 0;
 487     Jbig2ArithCx *GR_stats = NULL;
 488     int code = 0;
 489     Jbig2WordStream *ws = NULL;
 490     Jbig2ArithState *as = NULL;
 491     uint32_t table_index = 0;
 492     const Jbig2HuffmanParams *huffman_params = NULL;
 493 
 494     /* 7.4.1 */
 495     if (segment->data_length < 17)
 496         goto too_short;
 497     jbig2_get_region_segment_info(&region_info, segment_data);
 498     offset += 17;
 499 
 500     /* 7.4.3.1.1 */
 501     flags = jbig2_get_uint16(segment_data + offset);
 502     offset += 2;
 503 
 504     jbig2_error(ctx, JBIG2_SEVERITY_DEBUG, segment->number, ""text region header flags 0x%04x"", flags);
 505 
 506     /* zero params to ease cleanup later */
 507     memset(&params, 0, sizeof(Jbig2TextRegionParams));
 508 
 509     params.SBHUFF = flags & 0x0001;
 510     params.SBREFINE = flags & 0x0002;
 511     params.LOGSBSTRIPS = (flags & 0x000c) >> 2;
 512     params.SBSTRIPS = 1 << params.LOGSBSTRIPS;
 513     params.REFCORNER = (Jbig2RefCorner)((flags & 0x0030) >> 4);
 514     params.TRANSPOSED = flags & 0x0040;
 515     params.SBCOMBOP = (Jbig2ComposeOp)((flags & 0x0180) >> 7);
 516     params.SBDEFPIXEL = flags & 0x0200;
 517     /* SBDSOFFSET is a signed 5 bit integer */
 518     params.SBDSOFFSET = (flags & 0x7C00) >> 10;
 519     if (params.SBDSOFFSET > 0x0f)
 520         params.SBDSOFFSET -= 0x20;
 521     params.SBRTEMPLATE = flags & 0x8000;
 522 
 523     if (params.SBDSOFFSET) {
 524         jbig2_error(ctx, JBIG2_SEVERITY_DEBUG, segment->number, ""text region has SBDSOFFSET %d"", params.SBDSOFFSET);
 525     }
 526 
 527     if (params.SBHUFF) {        /* Huffman coding */
 528         /* 7.4.3.1.2 */
 529         huffman_flags = jbig2_get_uint16(segment_data + offset);
 530         offset += 2;
 531 
 532         if (huffman_flags & 0x8000)
 533             jbig2_error(ctx, JBIG2_SEVERITY_WARNING, segment->number, ""reserved bit 15 of text region huffman flags is not zero"");
 534     } else {                    /* arithmetic coding */
 535 
 536         /* 7.4.3.1.3 */
 537         if ((params.SBREFINE) && !(params.SBRTEMPLATE)) {
 538             params.sbrat[0] = segment_data[offset];
 539             params.sbrat[1] = segment_data[offset + 1];
 540             params.sbrat[2] = segment_data[offset + 2];
 541             params.sbrat[3] = segment_data[offset + 3];
 542             offset += 4;
 543         }
 544     }
 545 
 546     /* 7.4.3.1.4 */
 547     params.SBNUMINSTANCES = jbig2_get_uint32(segment_data + offset);
 548     offset += 4;
 549 
 550     if (params.SBHUFF) {
 551         /* 7.4.3.1.5 - Symbol ID Huffman table */
 552         /* ...this is handled in the segment body decoder */
 553 
 554         /* 7.4.3.1.6 - Other Huffman table selection */
 555         switch (huffman_flags & 0x0003) {
 556         case 0:                /* Table B.6 */
 557             params.SBHUFFFS = jbig2_build_huffman_table(ctx, &jbig2_huffman_params_F);
 558             break;
 559         case 1:                /* Table B.7 */
 560             params.SBHUFFFS = jbig2_build_huffman_table(ctx, &jbig2_huffman_params_G);
 561             break;
 562         case 3:                /* Custom table from referred segment */
 563             huffman_params = jbig2_find_table(ctx, segment, table_index);
 564             if (huffman_params == NULL) {
 565                 code = jbig2_error(ctx, JBIG2_SEVERITY_FATAL, segment->number, ""Custom FS huffman table not found (%d)"", table_index);
 566                 goto cleanup1;
 567             }
 568             params.SBHUFFFS = jbig2_build_huffman_table(ctx, huffman_params);
 569             ++table_index;
 570             break;
 571         case 2:                /* invalid */
 572         default:
 573             code = jbig2_error(ctx, JBIG2_SEVERITY_FATAL, segment->number, ""text region specified invalid FS huffman table"");
 574             goto cleanup1;
 575             break;
 576         }
 577         if (params.SBHUFFFS == NULL) {
 578             code = jbig2_error(ctx, JBIG2_SEVERITY_FATAL, segment->number, ""failed to allocate text region specified FS huffman table"");
 579             goto cleanup1;
 580         }
 581 
 582         switch ((huffman_flags & 0x000c) >> 2) {
 583         case 0:                /* Table B.8 */
 584             params.SBHUFFDS = jbig2_build_huffman_table(ctx, &jbig2_huffman_params_H);
 585             break;
 586         case 1:                /* Table B.9 */
 587             params.SBHUFFDS = jbig2_build_huffman_table(ctx, &jbig2_huffman_params_I);
 588             break;
 589         case 2:                /* Table B.10 */
 590             params.SBHUFFDS = jbig2_build_huffman_table(ctx, &jbig2_huffman_params_J);
 591             break;
 592         case 3:                /* Custom table from referred segment */
 593             huffman_params = jbig2_find_table(ctx, segment, table_index);
 594             if (huffman_params == NULL) {
 595                 code = jbig2_error(ctx, JBIG2_SEVERITY_FATAL, segment->number, ""Custom DS huffman table not found (%d)"", table_index);
 596                 goto cleanup1;
 597             }
 598             params.SBHUFFDS = jbig2_build_huffman_table(ctx, huffman_params);
 599             ++table_index;
 600             break;
 601         }
 602         if (params.SBHUFFDS == NULL) {
 603             code = jbig2_error(ctx, JBIG2_SEVERITY_FATAL, segment->number, ""failed to allocate text region specified DS huffman table"");
 604             goto cleanup1;
 605         }
 606 
 607         switch ((huffman_flags & 0x0030) >> 4) {
 608         case 0:                /* Table B.11 */
 609             params.SBHUFFDT = jbig2_build_huffman_table(ctx, &jbig2_huffman_params_K);
 610             break;
