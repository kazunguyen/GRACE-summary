 100 /* resize a Jbig2Image */
 101 Jbig2Image *
 102 jbig2_image_resize(Jbig2Ctx *ctx, Jbig2Image *image, uint32_t width, uint32_t height)
 103 {
 104     if (width == image->width) {
 105         /* check for integer multiplication overflow */
 106         int64_t check = ((int64_t) image->stride) * ((int64_t) height);
 107 
 108         if (check != (int)check) {
 109             jbig2_error(ctx, JBIG2_SEVERITY_FATAL, -1, ""integer multiplication overflow during resize stride(%d)*height(%d)"", image->stride, height);
 110             return NULL;
 111         }
 112         /* use the same stride, just change the length */
 113         image->data = jbig2_renew(ctx, image->data, uint8_t, (int)check);
 114         if (image->data == NULL) {
 115             jbig2_error(ctx, JBIG2_SEVERITY_FATAL, -1, ""could not resize image buffer!"");
 116             return NULL;
 117         }
 118         if (height > image->height) {
 119             memset(image->data + image->height * image->stride, 0, (height - image->height) * image->stride);
 120         }
 121         image->height = height;
 122 
 123     } else {
 124         /* we must allocate a new image buffer and copy */
 125         jbig2_error(ctx, JBIG2_SEVERITY_WARNING, -1, ""jbig2_image_resize called with a different width (NYI)"");
 126     }
 127 
 128     return NULL;
 129 }
 130 
 131 /* composite one jbig2_image onto another
 132    slow but general version */
 133 static int
 134 jbig2_image_compose_unopt(Jbig2Ctx *ctx, Jbig2Image *dst, Jbig2Image *src, int x, int y, Jbig2ComposeOp op)
 135 {
 136     uint32_t i, j;
 137     uint32_t sw = src->width;
 138     uint32_t sh = src->height;
 139     uint32_t sx = 0;
 140     uint32_t sy = 0;
 141 
 142     /* clip to the dst image boundaries */
 143     if (x < 0) {
 144         sx += -x;
 145         sw -= -x;
 146         x = 0;
 147     }
 148     if (y < 0) {
 149         sy += -y;
 150         sh -= -y;
 151         y = 0;
 152     }
 153     if (x + sw >= dst->width)
 154         sw = dst->width - x;
 155     if (y + sh >= dst->height)
 156         sh = dst->height - y;
 157 
 158     switch (op) {
 159     case JBIG2_COMPOSE_OR:
 160         for (j = 0; j < sh; j++) {
 161             for (i = 0; i < sw; i++) {
 162                 jbig2_image_set_pixel(dst, i + x, j + y, jbig2_image_get_pixel(src, i + sx, j + sy) | jbig2_image_get_pixel(dst, i + x, j + y));
 163             }
 164         }
 165         break;
 166     case JBIG2_COMPOSE_AND:
 167         for (j = 0; j < sh; j++) {
 168             for (i = 0; i < sw; i++) {
 169                 jbig2_image_set_pixel(dst, i + x, j + y, jbig2_image_get_pixel(src, i + sx, j + sy) & jbig2_image_get_pixel(dst, i + x, j + y));
 170             }
 171         }
 172         break;
 173     case JBIG2_COMPOSE_XOR:
 174         for (j = 0; j < sh; j++) {
 175             for (i = 0; i < sw; i++) {
 176                 jbig2_image_set_pixel(dst, i + x, j + y, jbig2_image_get_pixel(src, i + sx, j + sy) ^ jbig2_image_get_pixel(dst, i + x, j + y));
 177             }
 178         }
 179         break;
 180     case JBIG2_COMPOSE_XNOR:
 181         for (j = 0; j < sh; j++) {
 182             for (i = 0; i < sw; i++) {
 183                 jbig2_image_set_pixel(dst, i + x, j + y, (jbig2_image_get_pixel(src, i + sx, j + sy) == jbig2_image_get_pixel(dst, i + x, j + y)));
 184             }
 185         }
 186         break;
 187     case JBIG2_COMPOSE_REPLACE:
 188         for (j = 0; j < sh; j++) {
 189             for (i = 0; i < sw; i++) {
 190                 jbig2_image_set_pixel(dst, i + x, j + y, jbig2_image_get_pixel(src, i + sx, j + sy));
 191             }
 192         }
 193         break;
 194     }
 195 
 196     return 0;
 197 }
 198 
 199 /* composite one jbig2_image onto another */
 200 int
 201 jbig2_image_compose(Jbig2Ctx *ctx, Jbig2Image *dst, Jbig2Image *src, int x, int y, Jbig2ComposeOp op)
 202 {
 203     uint32_t i, j;
 204     uint32_t w, h;
 205     uint32_t leftbyte, rightbyte;
 206     uint32_t shift;
 207     uint8_t *s, *ss;
 208     uint8_t *d, *dd;
 209     uint8_t mask, rightmask;
 210 
 211     if (op != JBIG2_COMPOSE_OR) {
 212         /* hand off the the general routine */
 213         return jbig2_image_compose_unopt(ctx, dst, src, x, y, op);
 214     }
 215 
 216     /* clip */
 217     w = src->width;
 218     h = src->height;
 219     ss = src->data;
 220 
 221     if (x < 0) {
 222         w += x;
 223         x = 0;
 224     }
 225     if (y < 0) {
 226         h += y;
 227         y = 0;
 228     }
 229     w = ((uint32_t)x + w < dst->width) ? w : ((dst->width >= (uint32_t)x) ? dst->width - (uint32_t)x : 0);
 230     h = ((uint32_t)y + h < dst->height) ? h : ((dst->height >= (uint32_t)y) ? dst->height - (uint32_t)y : 0);
 231 #ifdef JBIG2_DEBUG
 232     jbig2_error(ctx, JBIG2_SEVERITY_DEBUG, -1, ""compositing %dx%d at (%d, %d) after clipping\n"", w, h, x, y);
 233 #endif
 234 
 235     /* check for zero clipping region */
 236     if ((w <= 0) || (h <= 0)) {
 237 #ifdef JBIG2_DEBUG
 238         jbig2_error(ctx, JBIG2_SEVERITY_DEBUG, -1, ""zero clipping region"");
 239 #endif
 240         return 0;
 241     }
 242 #if 0
 243     /* special case complete/strip replacement */
 244     /* disabled because it's only safe to do when the destination
 245        buffer is all-blank. */
 246     if ((x == 0) && (w == src->width)) {
 247         memcpy(dst->data + y * dst->stride, src->data, h * src->stride);
 248         return 0;
 249     }
 250 #endif
 251 
 252     leftbyte = (uint32_t)x >> 3;
 253     rightbyte = ((uint32_t)x + w - 1) >> 3;
 254     shift = x & 7;
 255 
 256     /* general OR case */
 257     s = ss;
 258     d = dd = dst->data + y * dst->stride + leftbyte;
 259     if (d < dst->data || leftbyte > dst->stride || h * dst->stride < 0 || d - leftbyte + h * dst->stride > dst->data + dst->height * dst->stride) {
 260         return jbig2_error(ctx, JBIG2_SEVERITY_FATAL, -1, ""preventing heap overflow in jbig2_image_compose"");
 261     }
 262     if (leftbyte == rightbyte) {
 263         mask = 0x100 - (0x100 >> w);
 264         for (j = 0; j < h; j++) {
 265             *d |= (*s & mask) >> shift;
 266             d += dst->stride;
 267             s += src->stride;
 268         }
 269     } else if (shift == 0) {
 270         rightmask = (w & 7) ? 0x100 - (1 << (8 - (w & 7))) : 0xFF;
 271         for (j = 0; j < h; j++) {
 272             for (i = leftbyte; i < rightbyte; i++)
 273                 *d++ |= *s++;
 274             *d |= *s & rightmask;
 275             d = (dd += dst->stride);
 276             s = (ss += src->stride);
 277         }
 278     } else {
 279         bool overlap = (((w + 7) >> 3) < ((x + w + 7) >> 3) - (x >> 3));
 280 
 281         mask = 0x100 - (1 << shift);
 282         if (overlap)
 283             rightmask = (0x100 - (0x100 >> ((x + w) & 7))) >> (8 - shift);
 284         else
 285             rightmask = 0x100 - (0x100 >> (w & 7));
 286         for (j = 0; j < h; j++) {
 287             *d++ |= (*s & mask) >> shift;
 288             for (i = leftbyte; i < rightbyte - 1; i++) {
 289                 *d |= ((*s++ & ~mask) << (8 - shift));
 290                 *d++ |= ((*s & mask) >> shift);
 291             }
 292             if (overlap)
 293                 *d |= (*s & rightmask) << (8 - shift);
 294             else
 295                 *d |= ((s[0] & ~mask) << (8 - shift)) | ((s[1] & rightmask) >> shift);
 296             d = (dd += dst->stride);
 297             s = (ss += src->stride);
 298         }
 299     }
 300 
 301     return 0;
 302 }
