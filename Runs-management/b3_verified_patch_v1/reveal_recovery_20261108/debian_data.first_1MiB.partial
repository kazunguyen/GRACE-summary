static int
TIFFWriteDirectoryTagShort(TIFF* tif, uint32* ndir, TIFFDirEntry* dir, uint16 tag, uint16 value)
{
 if (dir==NULL)
	{
		(*ndir)++;
 return(1);
	}
 return(TIFFWriteDirectoryTagCheckedShort(tif,ndir,dir,tag,value));
