 va_list ap_save; /* argument pointer */
 va_start(ap_save, format);
  retcode = dprintf_formatf(whereto, fputc, format, ap_save);
 va_end(ap_save);
 return retcode;
}


int curl_mvsprintf(char *buffer, const char *format, va_list ap_save)
{
 int retcode;
