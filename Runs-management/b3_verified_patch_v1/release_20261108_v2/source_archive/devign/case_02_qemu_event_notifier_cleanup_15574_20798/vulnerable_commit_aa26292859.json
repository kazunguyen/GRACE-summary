ttps://github.com/qemu/qemu/raw/aa262928595d431bfee7914cb7d9d79197f887a2/util%2Fevent_notifier-win32.c","contents_url":"https://api.github.com/repos/qemu/qemu/contents/util%2Fevent_notifier-win32.c?ref=aa262928595d431bfee7914cb7d9d79197f887a2","patch":"@@ -25,6 +25,7 @@ int event_notifier_init(EventNotifier *e, int active)\n void event_notifier_cleanup(EventNotifier *e)\n {\n     CloseHandle(e->event);\n+    e->event = NULL;\n }\n \n HANDLE event_notifier_get_handle(EventNotifier *e)"}]}